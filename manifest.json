{
  "action": {
    "default_icon": {
      "128": "icons/icon128.png",
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_popup": "popup.html",
    "default_title": "Download transcript"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "js": [
        "content.js"
      ],
      "matches": [
        "*://*.youtube.com/watch*",
        "*://*.youtube.com/shorts/*",
        "*://*.youtube.com/embed/*"
      ],
      "run_at": "document_idle"
    }
  ],
  "description": "Download YouTube captions in one click. No popups, no ads, no clutter.",
  "host_permissions": [
    "*://*.youtube.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "icons": {
    "128": "icons/icon128.png",
    "16": "icons/icon16.png",
    "48": "icons/icon48.png"
  },
  "manifest_version": 3,
  "name": "Minimal Transcript",
  "permissions": [
    "activeTab",
    "alarms",
    "scripting",
    "storage"
  ],
  "version": "1.4.0"
}
